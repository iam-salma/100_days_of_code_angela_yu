# SMTP (for sending emails)
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=your_smtp_password

# Sheety (for accessing Google Sheets via Sheety API)
SHEETY_USERNAME=your_sheety_username
SHEETY_PASSWORD=your_sheety_password
SHEETY_PRICES_ENDPOINT=https://api.sheety.co/your-project-id/flightDeals/prices
SHEETY_USERS_ENDPOINT=https://api.sheety.co/your-project-id/flightDeals/users

# Amadeus API (for flight data)
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_SECRET=your_amadeus_api_secret

# Twilio (for WhatsApp alerts)
TWILIO_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VIRTUAL_NUMBER=whatsapp:+1 your_twilio_number
TWILIO_VERIFIED_NUMBER=whatsapp:+1 your_verified_number
